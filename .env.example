# ==============================================================================
# ZJHX--CUMTB 本地环境配置文件模板（会随 Git 提交，请勿在此模板直接写真实密钥）
# 使用方法：将本文件复制一份命名为 .env（项目已默认生成），填入下方配置即可。
# 留空的项会自动回退读取系统环境变量或代码内置默认值。
# ==============================================================================

# 1. 阿里云通义千问 API Key（必填：把整个文件夹拷到新电脑时，填在这里就不用配系统环境变量了）
DASHSCOPE_API_KEY=

# 2. 打印机名称（选填：换电脑连接新打印机时填写系统里的完整打印机名称；留空默认 HP LaserJet Professional M1218nfs MFP）
PRINTER_NAME=

# 3. MySQL 数据库配置（选填：留空则默认连接本机 root / 123456 / zjhx_teaching，同时作用于后端与 Agent）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=zjhx_teaching

# 4. 其他可选配置（Windows 下一般留空即可）
# CHAT_MODEL_NAME=qwen-plus
# EMBEDDING_MODEL_NAME=text-embedding-v4
# REPORT_FONT_PATH=
